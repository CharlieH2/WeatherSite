<!DOCTYPE html>
<html lang="en">
<head>
    {% block head %}
    <link rel="stylesheet" href="{{ url_for('static', filename='style.css') }}" />
    <title>{% block title %}{% endblock %} - Weathersite</title>
    {% endblock %}
</head>
<body>
    <div id="navbar">{% block navbar %}{% endblock %}</div>
    <div id="content">{% block content %}{% endblock %}</div>
    <div id="footer">
        {% block footer %}
        &copy; Copyright 2026 by <a href="http://weathersite">Weathersite</a>.
        {% endblock %}
    </div>
</body>
</html>